# Copy to `.env` for local / Cursor laptop runs:
#   cp .env.example .env
#
# Existing process environment wins over `.env` (dotenv does not overwrite).
# Never commit `.env` or Gmail app passwords.
#
# Cursor cloud agents: set the same names as secrets in the cloud agent
# environment (do not rely on a committed file).
#
# Production (Edge / Docker): export these on the host or pass them into
# the container. Magic-link email uses Gmail SMTP; APP_HOST is the public
# hostname used in sign-in URLs (https).

# Gmail account that sends magic-link email
SMTP_USERNAME=

# Gmail app password (not the account login password)
SMTP_PASSWORD=

# Public host for mailer links. Production: msb-publishing.srv2019231.hstgr.cloud
# Leave blank in development to use localhost:3000
APP_HOST=

# Optional. Defaults to SMTP_USERNAME, then noreply@mystorybooklet.local
MAIL_FROM=

# Optional SMTP overrides (defaults match Gmail)
# SMTP_ADDRESS=smtp.gmail.com
# SMTP_PORT=587

# Optional. Development only: public tunnel host for magic-link emails
# TUNNEL_HOST=
# ALLOW_TUNNEL=

# Production Rails
# SECRET_KEY_BASE=
# RAILS_MASTER_KEY=
# RAILS_LOG_LEVEL=info
# PORT=3000

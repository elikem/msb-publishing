<% content_for :title, "#{@title_meta["title"]} — My Story Booklet" %>
<% content_for :head do %>
  <meta name="turbo-visit-control" content="reload">
<% end %>

<% draft_payload = {
  regions: @personalization&.regions_hash || {},
  lock_version: @personalization&.lock_version || 0,
  last_saved_at: @personalization&.last_saved_at&.iso8601,
  last_saved_by_admin: @personalization&.last_saved_by_admin?,
  outdated: @personalization&.outdated? || false,
  orphaned: @personalization&.orphaned_region_ids || [],
  primary_region_id: @title_meta.dig("editableRegions", 0, "id")
} %>

<div
  id="app"
  data-controller="booklet"
  data-booklet-meta-value="<%= ERB::Util.html_escape(@title_meta.to_json) %>"
  data-booklet-draft-value="<%= ERB::Util.html_escape(draft_payload.to_json) %>"
  data-booklet-save-url-value="<%= @save_url %>"
  data-turbo="false"
>
  <header class="app-header desktop-chrome">
    <div>
      <p class="eyebrow">My Story Booklet</p>
      <h1 data-booklet-target="title"><%= @title_meta["title"] %></h1>
      <p class="hint" data-booklet-target="lastSaved" hidden></p>
    </div>
    <div class="header-actions">
      <% if current_user_admin? && !@admin_edit %>
        <%= link_to "Admin", admin_root_path, class: "btn subtle", data: { booklet_leave_link: true } %>
      <% end %>
      <%= link_to "All titles", titles_path, class: "btn subtle", data: { booklet_leave_link: true } %>
      <button type="button" data-action="booklet#saveDraft" data-booklet-target="saveButton" class="btn primary">Save</button>
      <button type="button" data-action="booklet#downloadPdf" class="btn primary">Download PDF</button>
      <%= button_to "Sign out", session_path, method: :delete, class: "btn subtle", data: { turbo: false, booklet_leave_link: true } %>
    </div>
  </header>

  <div data-booklet-target="outdatedBanner" class="flash flash-alert app-flash" hidden role="alert"></div>
  <div data-booklet-target="overflowBanner" class="flash flash-alert app-flash" hidden role="alert"></div>
  <div data-booklet-target="orphanBanner" class="flash flash-alert app-flash" hidden role="status"></div>

  <% if flash[:notice].present? %>
    <p class="flash flash-notice app-flash" role="status"><%= flash[:notice] %></p>
  <% end %>

  <main class="app-main">
    <aside class="editor-panel" aria-label="Story editor">
      <div class="sheet-handle" aria-hidden="true"></div>
      <div class="sheet-header">
        <h2 data-booklet-target="editorHeading"><%= @title_meta.dig("editableRegions", 0, "label") || "Your story" %></h2>
        <button type="button" data-action="booklet#closeWriter" class="ghost-btn mobile-only">Done</button>
      </div>
      <p class="hint" data-booklet-target="storyHint">
        Your story pages in the booklet. Press Enter for a new paragraph. The preview updates as you type.
      </p>
      <div class="fill-meter" aria-live="polite">
        <div class="fill-bars" data-booklet-target="fillBars" aria-hidden="true"></div>
        <span class="fill-label" data-booklet-target="fillLabel">0 of 0 pages</span>
      </div>
      <textarea
        id="story-editor"
        data-booklet-target="editor"
        data-action="input->booklet#onEditorInput"
        spellcheck="true"
        aria-label="Personal story"
      ></textarea>
      <div class="sheet-actions">
        <button type="button" data-action="booklet#jumpStory" data-booklet-target="jumpStory" class="btn subtle">
          Jump to story
        </button>
        <button type="button" data-action="booklet#peekBook" class="btn mobile-only">Peek at book</button>
        <button type="button" data-action="booklet#previewStory" class="btn primary mobile-only">Preview</button>
        <button type="button" data-action="booklet#saveDraft" class="btn subtle mobile-only">Save</button>
      </div>
    </aside>

    <section class="book-panel" aria-label="Book preview">
      <div class="mobile-book-meta mobile-only">
        <p class="eyebrow" data-booklet-target="mobileEyebrow">My Story Booklet</p>
        <h2 data-booklet-target="mobileTitle"><%= @title_meta["title"] %></h2>
      </div>

      <div
        class="book-viewport"
        data-booklet-target="viewport"
        data-action="touchstart->booklet#onTouchStart touchend->booklet#onTouchEnd"
      >
        <div data-booklet-target="stage" class="page-stage"></div>
        <div data-booklet-target="editableBadge" class="editable-badge" hidden>Editable</div>
      </div>

      <p class="swipe-hint mobile-only">Swipe to turn pages</p>

      <nav class="book-controls" aria-label="Page navigation">
        <button type="button" data-action="booklet#prevPage" class="btn icon-nav" aria-label="Previous page">
          <span class="desktop-label">Previous</span>
          <span class="mobile-label" aria-hidden="true">‹</span>
        </button>
        <span data-booklet-target="indicator" class="page-indicator">Page 1 of <%= @title_meta["pageCount"] %></span>
        <button type="button" data-action="booklet#nextPage" class="btn icon-nav" aria-label="Next page">
          <span class="desktop-label">Next</span>
          <span class="mobile-label" aria-hidden="true">›</span>
        </button>
      </nav>

      <div class="mobile-dock mobile-only">
        <button type="button" data-action="booklet#openWriter" data-booklet-target="openWriter" class="write-cta">
          Write your story
        </button>
        <button type="button" data-action="booklet#openFinish" class="btn dock-secondary">Finish</button>
      </div>
    </section>
  </main>

  <div
    data-booklet-target="sheetBackdrop"
    data-action="click->booklet#closeWriter"
    class="sheet-backdrop mobile-only"
    hidden
    aria-hidden="true"
  ></div>

  <section data-booklet-target="finishScreen" class="finish-screen" hidden aria-label="Finish and download">
    <div class="finish-card">
      <p class="eyebrow">Ready</p>
      <h2>Your booklet is complete</h2>
      <p class="finish-lede" data-booklet-target="finishLede">
        Download the personalized PDF to keep or print.
      </p>
      <div class="finish-stats">
        <div class="finish-stat">
          <b data-booklet-target="finishPageCount"><%= @title_meta["pageCount"] %></b>
          <span>Total pages</span>
        </div>
        <div class="finish-stat">
          <b data-booklet-target="finishStoryPages">0</b>
          <span>Story pages filled</span>
        </div>
      </div>
      <button type="button" data-action="booklet#downloadPdf" class="btn primary finish-download">
        Download PDF
      </button>
      <button type="button" data-action="booklet#finishEdit" class="btn finish-secondary">
        Keep editing story
      </button>
      <button type="button" data-action="booklet#closeFinish" class="btn finish-secondary">Back to book</button>
    </div>
  </section>

  <dialog data-booklet-target="leaveDialog" class="finish-screen">
    <div class="finish-card">
      <h2>Unsaved changes</h2>
      <p>Save your story before leaving?</p>
      <button type="button" data-action="booklet#leaveSave" class="btn primary">Save</button>
      <button type="button" data-action="booklet#leaveDiscard" class="btn finish-secondary">Discard</button>
      <button type="button" data-action="booklet#leaveCancel" class="btn finish-secondary">Cancel</button>
    </div>
  </dialog>

  <div data-booklet-target="layoutHost" class="offscreen" aria-hidden="true"></div>
  <div data-booklet-target="exportHost" id="export-host" class="offscreen" aria-hidden="true"></div>
</div>

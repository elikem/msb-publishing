<% content_for :title, "Titles — My Story Booklet" %>

<section class="catalog-shell">
  <header class="catalog-header">
    <div>
      <p class="eyebrow">My Story Booklet</p>
      <h1>Choose a title</h1>
      <p class="catalog-lede">Personalize a published booklet, then download your PDF.</p>
    </div>
    <div class="header-actions">
      <% if current_user_admin? %>
        <%= link_to "Admin", admin_root_path, class: "btn subtle" %>
      <% end %>
      <%= button_to "Sign out", session_path, method: :delete, class: "btn subtle", data: { turbo: false } %>
    </div>
  </header>

  <% if flash[:notice].present? %>
    <p class="flash flash-notice" role="status"><%= flash[:notice] %></p>
  <% end %>
  <% if flash[:alert].present? %>
    <p class="flash flash-alert" role="alert"><%= flash[:alert] %></p>
  <% end %>

  <% if @locales.empty? %>
    <p class="catalog-empty">No published titles yet.</p>
  <% else %>
    <ul class="catalog-list">
      <% @locales.each do |locale| %>
        <% pers = @personalizations[locale.id] %>
        <li class="catalog-item">
          <%= link_to booklet_locale_path(slug: locale.title.slug, locale: locale.locale), class: "catalog-link" do %>
            <span class="catalog-title"><%= locale.name %></span>
            <span class="catalog-summary"><%= locale.title.slug %> · <%= locale.locale %></span>
            <% if locale.summary.present? %>
              <span class="catalog-summary"><%= locale.summary %></span>
            <% end %>
            <span class="catalog-meta">
              <% if pers %>
                Last saved <%= time_ago_in_words(pers.last_saved_at) %> ago
              <% else %>
                Not started
              <% end %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

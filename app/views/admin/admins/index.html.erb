<% content_for :admin_title, "Administrators" %>

<ul class="catalog-list">
  <% @users.each do |user| %>
    <li class="catalog-item catalog-link">
      <span class="catalog-title"><%= user.email %></span>
      <% if user.operator? %>
        <span class="catalog-meta">Always admin</span>
      <% elsif user.admin? %>
        <%= button_to "Revoke admin", admin_admin_path(user), method: :patch, params: { admin: false }, class: "btn subtle" %>
      <% else %>
        <%= button_to "Grant admin", admin_admin_path(user), method: :patch, params: { admin: true }, class: "btn subtle" %>
      <% end %>
    </li>
  <% end %>
</ul>
